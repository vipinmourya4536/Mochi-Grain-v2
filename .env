DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Railway Admin Panel API ────────────────────────────────────────
# Mochi-Grain Discover feed source. Set this to YOUR deployed Railway
# admin panel domain (https only), with NO trailing slash and NO /api
# suffix — the app appends the path itself:
#
#   NEXT_PUBLIC_ADMIN_API_URL=https://your-admin-panel.up.railway.app
#
# Example request the app will make:
#   GET {ADMIN_API_URL}/api/discover?grainType=wheat&moisture=14.2&conditionStatus=warn
#
# Expected JSON response (either a bare array or { "videos": [...] }):
#   {
#     "videos": [
#       {
#         "id": "abc123",                  // required, unique
#         "title": "...",                  // required
#         "url": "https://youtu.be/...",   // required
#         "isApproved": true,              // required — only true items render
#         "source": "Channel name",        // optional
#         "thumbnail": "https://...",      // optional
#         "why": "Why recommended",        // optional
#         "tags": ["drying"]               // optional
#       }
#     ]
#   }
#
# Leave this commented out until you set your real domain — the Discover
# tab then shows a clean "admin panel not connected" state.
# NEXT_PUBLIC_ADMIN_API_URL=
